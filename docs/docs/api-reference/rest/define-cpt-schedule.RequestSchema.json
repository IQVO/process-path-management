{"title":"Body","body":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["timezone","cutoffs"],"properties":{"timezone":{"type":"string","minLength":1,"description":"IANA zone, e.g. America/Sao_Paulo.","example":"America/Sao_Paulo"},"cutoffs":{"type":"array","minItems":1,"items":{"type":"object","required":["cptId","localTime","daysOfWeek","shipMethod","eligiblePathIds"],"properties":{"cptId":{"type":"string","minLength":1,"description":"Stable id, unique within the site, e.g. \"sp1-1500\".","example":"sp1-1500"},"localTime":{"type":"string","minLength":1,"pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$","description":"Recurring daily cutoff, \"HH:MM\" 24-hour form.","example":"15:00"},"daysOfWeek":{"type":"array","minItems":1,"items":{"type":"string","enum":["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]},"example":["Mon","Tue","Wed","Thu","Fri"]},"shipMethod":{"type":"string","minLength":1,"description":"Free-form label (\"ground\", \"same-day\"); no carrier integration exists in this fleet.","example":"ground"},"eligiblePathIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"description":"The path families that can make this cutoff. Each entry must reference an Active ProcessPath in this service's own store (checked at write time).\n","example":["PICK"]}},"title":"Cutoff"}}},"title":"DefineCPTScheduleRequest"}}}}}